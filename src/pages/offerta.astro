---
// Ads landing: no navigation (Base landing), noindex, form above the fold on mobile.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Faq from '../components/Faq.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { media } from '../data/media';
import { site, euro } from '../data/site';
import { hv as h } from '../lib/txt';

const faqs = [
  { q: 'Quanto costa trasformare la vasca in doccia?', a: 'Una trasformazione standard con Venere Bagni parte da 3.500 €. Il prezzo fisso per il tuo bagno lo trovi nel preventivo scritto che ti lasciamo dopo il sopralluogo gratuito a casa tua.' },
  { q: 'Quanto dura il lavoro?', a: 'Un giorno di lavoro [DA CONFERMARE]. La squadra di Venere Bagni arriva la mattina e la sera la doccia si può già usare.' },
  { q: 'Il sopralluogo mi impegna?', a: 'No. Il sopralluogo di Venere Bagni è gratuito e non ti impegna. Ti lasciamo il preventivo e decidi tu quando.' },
  { q: 'Lavorate anche nella mia zona?', a: 'Venere Bagni lavora a Torino, Cuneo, Novara e nelle altre province del Piemonte. Scrivi il CAP nel modulo e ti diciamo subito se arriviamo.' },
];
const reviews = [
  { text: 'Misurato il lunedì, finito il giovedì. Il prezzo era quello scritto.', name: 'Maria', town: 'Moncalieri' },
  { text: 'Mia madre ora fa la doccia seduta e da sola.', name: 'Giorgio', town: 'Rivoli' },
  { text: 'Hanno lasciato il bagno pulito e mi hanno richiamata dopo.', name: 'Lucia', town: 'Collegno' },
];
---
<Base
  title="Vasca in doccia in 1 giorno | Offerta Venere Bagni"
  description="Sostituisci la vasca con la doccia in un giorno. Sopralluogo gratuito a casa tua in Piemonte e preventivo scritto a prezzo fisso, da 3.500 €."
  landing
  noindex
>
  <p class="offer-band" set:html={h('[OFFERTA DEL MESE: DA DEFINIRE, scadenza gg/mm]')} />

  <section class="lp-hero">
    <div class="wrap lp-hero__grid">
      <div class="lp-hero__text">
        <h1>Sostituisci la vasca con la doccia in un giorno</h1>
        <p class="lead" set:html={h('Veniamo a casa tua, in Piemonte, a misurare il bagno senza costi e ti lasciamo un preventivo a prezzo fisso. Si parte da 3.500 € [DA CONFERMARE: IVA inclusa?].')} />
      </div>
      <div class="lp-hero__form"><LeadForm id="prenota" title="Vediamo se arriviamo nella tua zona" next1="Inizia con il CAP" /></div>
        <div class="lp-hero__more">
          <ul class="chips-row">
            <li><Icon n="check" />Sopralluogo gratuito</li>
            <li><Icon n="check" />Prezzo fisso scritto</li>
            <li><Icon n="check" />Da {euro(site.priceFrom)}</li>
          </ul>
          <p class="trust-line"><span class="stars" aria-hidden="true">★★★★★</span><span set:html={h('[VOTO GOOGLE] su 5 da [N° RECENSIONI] recensioni Google')} /></p>
          <p class="hero__alt" set:html={h(`Preferisci telefonare? Chiama il ${site.phone}.`)} />
          <div class="lp-hero__img"><Image src={media.hero.src} alt={media.hero.alt} widths={[640, 960, 1400]} sizes="(max-width: 960px) 100vw, 560px" /></div>
        </div>
    </div>
  </section>

  <section class="promises promises--3" aria-label="Perché sceglierci">
    <div class="wrap">
      <ul>
        <li><Icon n="home" /><div><strong>Sopralluogo gratuito</strong><span>Misuriamo a casa tua e non paghi niente.</span></div></li>
        <li><Icon n="doc" /><div><strong>Prezzo fisso scritto</strong><span>Sai quanto spendi prima di decidere.</span></div></li>
        <li><Icon n="clock" /><div><strong>Un giorno di lavoro</strong><span set:html={h('La sera la doccia è pronta [DA CONFERMARE].')} /></div></li>
      </ul>
    </div>
  </section>

  <section class="section" id="prima-dopo">
    <div class="wrap">
      <div class="head">
        <h2>Tre bagni in Piemonte, prima e dopo</h2>
        <p class="muted">Sposta la barra su ogni foto per vedere la differenza.</p>
      </div>
      <div class="ba-grid">
        <BeforeAfter before="ba1p" after="ba1d" caption="[CITTÀ] · doccia a piatto basso con panca" />
        <BeforeAfter before="ba2p" after="ba2d" caption="[CITTÀ] · doccia con porta in vetro e maniglioni" />
        <BeforeAfter before="ba4p" after="ba4d" caption="[CITTÀ] · doccia walk-in a filo pavimento" />
      </div>
    </div>
  </section>

  <section class="section section--sand" id="come-funziona">
    <div class="wrap">
      <div class="head"><h2>Come funziona</h2></div>
      <ol class="steps">
        <li><h3>Ci lasci CAP e telefono</h3><p set:html={h('Ti richiamiamo entro [X ORE].')} /></li>
        <li><h3>Veniamo a misurare, gratis</h3><p>Ti facciamo vedere cosa si può montare nel tuo bagno.</p></li>
        <li><h3>Ti lasciamo il preventivo scritto</h3><p>Il prezzo è fisso e non devi decidere subito.</p></li>
        <li><h3>Facciamo il lavoro in un giorno</h3><p>La sera usi già la doccia nuova.</p></li>
      </ol>
    </div>
  </section>

  <section class="section" id="recensioni">
    <div class="wrap reviews--3">
      <div class="head"><h2>Cosa dicono i clienti</h2><p class="muted" set:html={h('[VOTO GOOGLE] su 5 · [N° RECENSIONI] recensioni su Google')} /></div>
      <Reviews items={reviews} />
    </div>
  </section>

  <section class="section section--sand" id="domande">
    <div class="wrap narrow">
      <div class="head"><p class="eyebrow">Domande frequenti</p><h2>Prima di prenotare</h2></div>
      <Faq items={faqs} open verbose />
    </div>
  </section>

  <CtaBand title="Prenota il sopralluogo gratuito" text="Lasciaci il CAP e un numero di telefono. Un nostro tecnico ti chiama per fissare il sopralluogo quando ti fa comodo." />
</Base>
