---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import { zonePages } from '../data/zone-pages';
import { u } from '../lib/url';
import { hv as h } from '../lib/txt';

const crumbs = [{ name: 'Contatti', path: '/contatti/' }];
const recapiti: [string, string, string?][] = [
  ['Telefono', site.phone, `tel:${site.phoneHref}`],
  ['WhatsApp', site.whatsappLabel, `https://wa.me/${site.whatsapp}`],
  ['Indirizzo', site.street],
  ['Orari', site.hours],
  ['Azienda', `${site.legalName}, P.IVA ${site.vat}`],
];
---
<Base
  title="Contatti | Venere Bagni, Torino e provincia"
  description="Telefono, WhatsApp e modulo per prenotare il sopralluogo gratuito di Venere Bagni. Lavoriamo a Torino e in tutta la provincia."
  crumbs={crumbs}
  pageType="ContactPage"
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Torino e provincia"
    title="Contatti"
    lead="Chiamaci, scrivici su WhatsApp o lascia il CAP nel modulo. Ogni giorno gestiamo decine di chiamate e rispondiamo entro [X ORE]."
    formTitle="Prenota il sopralluogo gratuito"
    contacts={false}
  >
    <div class="tbl-wrap">
      <table class="tbl">
        <caption>Recapiti di Venere Bagni</caption>
        <tbody>
          {recapiti.map(([k, v, href]) => (
            <tr><th scope="row">{k}</th><td>{href ? <a href={href} set:html={h(v)} /> : <span set:html={h(v)} />}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </PageHero>

  <section class="section" id="zone">
    <div class="wrap split">
      <div>
        <h2>Dove lavoriamo</h2>
        <p>A Torino e in tutta la provincia. I comuni serviti sono nella pagina su <a href={u('/zone/torino/')}>Torino e provincia</a>:</p>
        <ul class="zones"><li><a href={u('/zone/torino/')}>Torino città</a></li>{zonePages[0].towns.map(([a]) => <li><a href={u('/zone/torino/#comuni')}>{a}</a></li>)}</ul>
      </div>
      <div class="map-ph"><p class="muted" set:html={h('[MAPPA GOOGLE: inserire dopo conferma dell’indirizzo]')} /></div>
    </div>
  </section>
</Base>
