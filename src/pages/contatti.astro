---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site, zones } from '../data/site';
import { u } from '../lib/url';
import { hv as h, hasPh } from '../lib/txt';
import { isPreview } from '../lib/url';

const crumbs = [{ name: 'Contatti', path: '/contatti/' }];
const recapiti: [string, string, string?][] = [
  ['Telefono', site.phone, `tel:${site.phoneHref}`],
  ['WhatsApp', site.whatsappLabel, `https://wa.me/${site.whatsapp}`],
  ['Indirizzo', site.street],
  ['Orari', site.hours],
  ['Email', site.email, `mailto:${site.email}`],
  ['Instagram', '@venerebagni', site.instagram],
  ['Azienda', `${site.legalName}, P.IVA ${site.vat}`],
];
// Live builds: rows without real data are left out (the company row keeps just the name until the P.IVA exists).
const rows = isPreview ? recapiti : recapiti
  .map(([k, v, href]) => (k === 'Azienda' && hasPh(v) ? [k, site.legalName, href] as [string, string, string?] : [k, v, href] as [string, string, string?]))
  .filter(([, v]) => !hasPh(v));
---
<Base
  title="Contatti | Venere Bagni, Torino e Piemonte"
  description="Telefono, WhatsApp e modulo per prenotare il sopralluogo gratuito di Venere Bagni. Lavoriamo a Torino e in tutto il Piemonte."
  crumbs={crumbs}
  pageType="ContactPage"
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Torino e tutto il Piemonte"
    title="Contatti"
    lead="Chiamaci, scrivici su WhatsApp o lascia il CAP nel modulo. Ogni giorno gestiamo decine di chiamate e rispondiamo entro [X ORE]."
    formTitle="Prenota il sopralluogo gratuito"
    contacts={false}
  >
    <div class="tbl-wrap">
      <table class="tbl">
        <caption>Recapiti di Venere Bagni</caption>
        <tbody>
          {rows.map(([k, v, href]) => (
            <tr><th scope="row">{k}</th><td>{href ? <a href={href} set:html={h(v)} /> : <span set:html={h(v)} />}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </PageHero>

  <section class="section" id="zone">
    <div class="wrap split">
      <div>
        <h2>Dove lavoriamo</h2>
        <p>A Torino, nella sua provincia e nel resto del Piemonte. Queste sono le pagine per zona:</p>
        <ul class="zones">{zones.map((z) => <li><a href={u(`/zone/${z.slug}/`)}>{z.name}</a></li>)}</ul>
      </div>
      {isPreview && <div class="map-ph"><p class="muted" set:html={h('[MAPPA GOOGLE: inserire dopo conferma dell’indirizzo]')} /></div>}
    </div>
  </section>
</Base>
