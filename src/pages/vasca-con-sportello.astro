---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { u } from '../lib/url';
import { hv as h } from '../lib/txt';

const crumbs = [{ name: 'Vasca con sportello', path: '/vasca-con-sportello/' }];
const quando = [
  ['Alla persona piace fare il bagno e non vuole rinunciarci', 'Resta una vasca vera'],
  ['Il bagno è troppo stretto per un piatto doccia comodo', 'Si usa lo spazio della vasca esistente'],
  ['Serve un bagno caldo per dolori articolari', 'Si resta seduti con l’acqua fino alle spalle'],
];
const faqs = [
  { q: 'Come funziona una vasca con sportello?', a: 'La vasca con sportello di Venere Bagni ha una porta stagna sul fianco. Ti siedi, chiudi lo sportello e riempi la vasca; prima di uscire la devi svuotare. Così il bordo non lo scavalchi mai ed eviti di cadere entrando e uscendo.' },
  { q: 'Quanto tempo serve per installare una vasca con sportello?', a: 'Venere Bagni installa la vasca con sportello in [DA CONFERMARE: 1 o 2 giorni] di lavoro, a seconda del bagno. I tempi esatti te li diciamo al sopralluogo gratuito e li trovi scritti nel preventivo.' },
  { q: 'La vasca con sportello è adatta a una persona anziana?', a: 'Sì, è fatta apposta per chi non riesce più a scavalcare il bordo. Venere Bagni la monta con maniglioni e fondo antiscivolo. Se la persona non riesce a stare seduta da sola, al sopralluogo vediamo insieme se è più sicura una doccia con seggiolino.' },
  { q: 'Posso tenere la vasca che ho e aggiungere solo lo sportello?', a: 'Di solito no, perché lo sportello fa parte della vasca. Venere Bagni sostituisce la vecchia vasca con un modello nuovo della stessa misura, così il resto del bagno non si tocca.' },
];
---
<Base
  title="Vasca con sportello per anziani, Torino | Venere Bagni"
  description="Vasca con sportello laterale per entrare senza scavalcare il bordo. Installazione a Torino e in Piemonte, sopralluogo gratuito e prezzo fisso."
  faqs={faqs}
  crumbs={crumbs}
  service={{ name: 'Installazione vasca con sportello', description: 'Sostituzione della vecchia vasca con una vasca con sportello laterale e seggiolino interno, per entrare senza scavalcare il bordo, a Torino e in Piemonte.' }}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Torino e tutto il Piemonte"
    title="Vasca con sportello: si entra senza scavalcare il bordo"
    lead="Per chi vuole continuare a fare il bagno ma non riesce più ad alzare la gamba oltre il bordo. Togliamo la vecchia vasca e montiamo la nuova, con il prezzo scritto prima."
    chips={['Sopralluogo gratuito', 'Prezzo fisso scritto', 'Si entra da seduti']}
    img="solSportello"
    formTitle="Prenota il sopralluogo gratuito"
  />

  <section class="section" id="cos-e">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Che cos’è</p>
        <h2>Una vasca vera, con una porta sul lato</h2>
        <p>Ha una porta stagna sul lato: la apri, ti siedi sul seggiolino interno, richiudi e la vasca si riempie. Per uscire prima la svuoti, poi apri la porta.</p>
        <p>La scelgono soprattutto persone a cui piace il bagno caldo ma che hanno problemi alle articolazioni o di equilibrio. Si entra con un passo basso e ci si siede subito.</p>
      </div>
      <BeforeAfter before="prima3" after="dopo3" caption="[CITTÀ] · vasca con sportello · [DURATA]" />
    </div>
  </section>

  <section class="section section--sand" id="quando">
    <div class="wrap narrow">
      <h2>Quando ha senso tenere la vasca</h2>
      <div class="tbl-wrap">
        <table class="tbl">
          <caption>Quando conviene la vasca con sportello</caption>
          <thead><tr><th scope="col">Situazione</th><th scope="col">Perché</th></tr></thead>
          <tbody>{quando.map(([a, b]) => <tr><td>{a}</td><td>{b}</td></tr>)}</tbody>
        </table>
      </div>
      <p>Se in bagno ci si fa solo la doccia, di solito conviene la <a href={u('/vasca-in-doccia/')}>trasformazione in doccia</a>: costa meno e si pulisce più in fretta. Al sopralluogo ti diciamo quale delle due va meglio nel tuo caso.</p>
    </div>
  </section>

  <section class="section" id="lavoro">
    <div class="wrap narrow">
      <h2>Come la montiamo</h2>
      <p set:html={h('Smontiamo la vecchia vasca, posiamo quella con sportello, colleghiamo scarico e rubinetteria e sistemiamo le pareti intorno. Servono [DA CONFERMARE: 1 o 2 giorni] di lavoro. Quando poi la usi, ricorda che lo sportello si apre solo dopo che la vasca si è svuotata.')} />
    </div>
  </section>

  <section class="section section--sand" id="prezzo">
    <div class="wrap narrow">
      <h2>Quanto costa</h2>
      <div class="price-box">
        <p class="from"><small>Prezzo a partire da</small><span set:html={h('[DA X €]')} /></p>
        <div>
          <p>Il prezzo comprende fornitura e installazione e cambia con il modello e le misure. Quello preciso te lo scriviamo dopo il sopralluogo gratuito.</p>
          <a class="link-arrow" href={u('/prezzi/')}>Tutti i prezzi</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="domande">
    <div class="wrap narrow">
      <div class="head"><p class="eyebrow">Domande frequenti</p><h2>Domande sulla vasca con sportello</h2></div>
      <Faq items={faqs} open verbose />
    </div>
  </section>

  <CtaBand title="Vuoi vedere se ci sta nel tuo bagno?" text="Veniamo a misurare e ti facciamo vedere il modello adatto. Il sopralluogo è gratuito." />
</Base>
