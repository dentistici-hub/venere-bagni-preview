---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { media } from '../data/media';
import { bonusShort } from '../data/bonus';
import { u } from '../lib/url';
import { hv as h } from '../lib/txt';

const crumbs = [{ name: 'Bagno sicuro', path: '/bagno-sicuro/' }];
const elementi = [
  ['Piatto doccia a filo pavimento', 'Niente scalino da scavalcare. Si entra anche con un deambulatore o una sedia da doccia'],
  ['Superficie antiscivolo', 'Il fondo non scivola, anche con il sapone'],
  ['Maniglioni', 'Un appoggio sicuro per entrare, alzarsi e girarsi'],
  ['Seggiolino ribaltabile', 'Si fa la doccia seduti e poi si ribalta a parete'],
  ['Box con apertura larga', 'Il passaggio è comodo e non si sbatte'],
  ['Miscelatore termostatico', 'L’acqua non diventa troppo calda all’improvviso [DA CONFERMARE: incluso o opzionale]'],
  ['Luce e interruttori accessibili', 'Si accende senza cercare al buio [DA CONFERMARE: servizio offerto?]'],
];
const faqs = [
  { q: 'Che cosa rende sicuro un bagno per una persona anziana?', a: 'Un bagno sicuro di Venere Bagni ha la doccia a filo pavimento senza scalino, il fondo antiscivolo, i maniglioni messi nei punti giusti e un seggiolino ribaltabile. Servono a ridurre il rischio di cadere, che in bagno è più alto che nel resto della casa.' },
  { q: 'Posso chiedere io il preventivo per mio padre o mia madre?', a: 'Sì, a Venere Bagni capita spesso di parlare con i figli. Puoi prenotare tu il sopralluogo, esserci di persona o collegarti al telefono, e ricevere il preventivo scritto. Il sopralluogo non costa niente e la decisione la prendete voi, in famiglia.' },
  { q: 'Il lavoro è faticoso o rumoroso per una persona anziana?', a: 'La squadra di Venere Bagni lavora una giornata e in quel tempo il bagno non si può usare. Il rumore c’è soprattutto la mattina, quando si toglie la vasca. Se il genitore preferisce, può passare la giornata da un parente. L’orario lo decidiamo insieme, in modo da dare meno disturbo possibile.' },
  { q: 'I maniglioni vanno bene per qualsiasi parete?', a: 'I maniglioni vanno fissati su una parete solida. Venere Bagni controlla la parete al sopralluogo e, se serve, la rinforza prima di montarli, così il maniglione non cede proprio quando ci si appoggia.' },
];
---
<Base
  title="Bagno sicuro per anziani a Torino | Venere Bagni"
  description="Doccia a filo pavimento, maniglioni e seggiolino per un bagno sicuro. Per anziani e per i figli che scelgono per loro. Sopralluogo gratuito in Piemonte."
  faqs={faqs}
  crumbs={crumbs}
  service={{ name: 'Bagno sicuro per anziani', description: 'Adattamento del bagno per chi ha difficoltà a muoversi: doccia a filo pavimento, fondo antiscivolo, maniglioni e seggiolino ribaltabile, a Torino e in Piemonte.' }}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Torino e tutto il Piemonte"
    title="Un bagno sicuro per te o per un tuo genitore"
    lead="In casa è nel bagno che si cade più spesso. Lo adattiamo in un giorno [DA CONFERMARE], con il prezzo scritto prima e senza toccare il resto della casa."
    chips={['Sopralluogo gratuito', 'Anche con il familiare', 'Prezzo fisso scritto']}
    img="hero"
    badge={['Doccia sicura con seggiolino', 'montata al posto della vasca']}
    formTitle="Prenota il sopralluogo gratuito"
  />

  <section class="section" id="per-chi">
    <div class="wrap split">
      <div>
        <h2>Chi ci chiama</h2>
        <p>Ci cerca chi ha superato i 65 anni e fa fatica a scavalcare la vasca. Molto spesso però a telefonare sono i figli.</p>
        <div class="note"><p>Se chiami per un genitore, possiamo parlare con te, fissare il sopralluogo con lui o con lei e mandare il preventivo a te. Al sopralluogo puoi esserci anche se non vivi in quella casa, oppure collegarti per telefono: l’orario lo concordiamo insieme.</p></div>
      </div>
      <Image src={media.famiglia.src} alt={media.famiglia.alt} widths={[640, 960]} sizes="(max-width: 960px) 100vw, 560px" />
    </div>
  </section>

  <section class="section section--sand" id="cosa">
    <div class="wrap narrow">
      <h2>Cosa montiamo e a cosa serve</h2>
      <div class="tbl-wrap">
        <table class="tbl">
          <caption>Che cosa installiamo e a che cosa serve</caption>
          <thead><tr><th scope="col">Elemento</th><th scope="col">A che cosa serve</th></tr></thead>
          <tbody>{elementi.map(([a, b]) => <tr><th scope="row">{a}</th><td set:html={h(b)} /></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" id="come">
    <div class="wrap split">
      <Image src={media.sopralluogo.src} alt={media.sopralluogo.alt} widths={[640, 960]} sizes="(max-width: 960px) 100vw, 560px" />
      <div>
        <p class="eyebrow">Il sopralluogo</p>
        <h2>Guardiamo come si muove chi userà la doccia</h2>
        <p>Ci interessa sapere se usa il bastone o ha un lato più debole, e se ha bisogno di sedersi. Da questo dipende dove mettiamo i maniglioni, quindi ogni preventivo è diverso.</p>
      </div>
    </div>
  </section>

  <section class="section section--sand" id="prezzo">
    <div class="wrap narrow">
      <h2>Quanto costa il bagno sicuro</h2>
      <div class="price-box">
        <p class="from"><small>Pacchetto bagno sicuro</small><span set:html={h('[DA X €]')} /></p>
        <div>
          <p>Il prezzo dipende da quali elementi decidi di mettere.</p>
          <a class="link-arrow" href={u('/prezzi/')}>Tutti i prezzi</a>
        </div>
      </div>
      <h3 style="margin-top:36px">Detrazioni</h3>
      <div class="note"><p set:html={h(bonusShort)} /></div>
      <p style="margin-top:16px"><a class="link-arrow" href={u('/bonus-detrazioni/')}>Le detrazioni 2026 nel dettaglio</a></p>
    </div>
  </section>

  <section class="section" id="domande">
    <div class="wrap narrow">
      <div class="head"><p class="eyebrow">Domande frequenti</p><h2>Domande sul bagno sicuro</h2></div>
      <Faq items={faqs} open verbose />
    </div>
  </section>

  <CtaBand title="Prenota il sopralluogo gratuito" text="Chiamaci o scrivici su WhatsApp. Fissiamo il sopralluogo gratuito, anche insieme al familiare che decide." />
</Base>
