---
import { site, filled } from '../data/site';
import { isPreview } from '../lib/url';
const tel = isPreview || filled(site.phone);
const hasWa = isPreview || filled(site.whatsappLabel);
import Icon from './Icon.astro';
interface Props { formHref?: string }
const { formHref = '#prenota' } = Astro.props;
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Buongiorno, vorrei informazioni per trasformare la vasca in doccia.')}`;
---
<nav class={`mbar${tel && hasWa ? '' : ' mbar--short'}`} aria-label="Contatti rapidi">
  {tel && <a href={`tel:${site.phoneHref}`}><Icon n="phone" />Chiama</a>}
  {hasWa && <a class="mbar__wa" href={wa} target="_blank" rel="noopener"><Icon n="wa" />WhatsApp</a>}
  {!tel && <a href={`mailto:${site.email}`}><Icon n="doc" />Email</a>}
  <a class="mbar__go" href={formHref}><Icon n="calendar" />Sopralluogo gratis</a>
</nav>
