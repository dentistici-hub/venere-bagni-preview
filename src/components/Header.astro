---
import { site, nav, filled } from '../data/site';
import { u, isPreview } from '../lib/url';
import { h } from '../lib/txt';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
interface Props { minimal?: boolean; formHref?: string }
const { minimal = false, formHref = '#prenota' } = Astro.props;
const here = Astro.url.pathname;
---
<div class="topbar">
  <div class="wrap">
    <span class="t-left">Torino e tutto il Piemonte · Sopralluogo gratuito</span>
    {filled(site.phone) || isPreview ? <span>Chiama: <a href={`tel:${site.phoneHref}`} set:html={h(site.phone)} />{site.openingHours.length > 0 && <span class="t-left"> · {site.hours}</span>}</span> : <span><a href={`mailto:${site.email}`}>{site.email}</a></span>}
  </div>
</div>
<header class={`hdr${minimal ? ' lp-hdr' : ''}`}>
  <div class="wrap">
    <Logo />
    {!minimal && (
      <>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu>Menu</button>
        <nav class="nav" id="menu" aria-label="Menu principale">
          {nav.map((l) => <a href={u(l.href)} aria-current={here.endsWith(l.href) ? 'page' : undefined}>{l.label}</a>)}
        </nav>
      </>
    )}
    <a class="btn btn--hdr" href={formHref} style={minimal ? 'margin-left:auto' : ''}><Icon n="calendar" /> Sopralluogo gratis</a>
  </div>
</header>
