---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Faq from '../components/Faq.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { media } from '../data/media';
import { site, zones, euro } from '../data/site';
import { bonusShort } from '../data/bonus';
import { u } from '../lib/url';
import { h } from '../lib/txt';

const faqs = [
  { q: 'Quanto tempo ci vuole per trasformare la vasca in doccia?', a: 'Con Venere Bagni la trasformazione della vasca in doccia richiede un giorno di lavoro [DA CONFERMARE]. La squadra arriva la mattina, toglie la vasca, monta piatto, pareti e box, e la sera la doccia si può già usare. Prima c’è il sopralluogo gratuito, di circa [DURATA] minuti, per prendere le misure.' },
  { q: 'Quanto costa trasformare la vasca in doccia a Torino?', a: 'A Torino una trasformazione standard della vasca in doccia con Venere Bagni parte da 3.500 € [DA CONFERMARE: IVA inclusa?]. Il prezzo finale dipende dalla misura del bagno, dal tipo di piatto e dal rivestimento. Dopo il sopralluogo gratuito ti lasciamo un preventivo scritto a prezzo fisso, voce per voce.' },
  { q: 'Il sopralluogo è davvero gratuito?', a: 'Sì, il sopralluogo di Venere Bagni è gratuito e non ti impegna. Un tecnico viene a casa tua, in Piemonte, misura il bagno, ti fa vedere cosa si può montare e ti lascia il preventivo scritto. Se poi decidi di non farlo, non devi niente.' },
  { q: 'Devo rifare anche il pavimento e le piastrelle?', a: 'Di solito no. Venere Bagni posa il piatto doccia e le pareti nello spazio della vasca, e il resto del bagno resta com’è. Se nel tuo bagno serve qualche ripristino te lo diciamo al sopralluogo e lo trovi scritto nel preventivo.' },
  { q: 'Fate lavori anche per persone anziane o con difficoltà a camminare?', a: 'Sì. Venere Bagni monta piatti doccia a filo pavimento, maniglioni, seggiolini e superfici antiscivolo per chi fa fatica a scavalcare il bordo della vasca. Puoi chiamarci anche se cerchi una soluzione sicura per un tuo genitore.' },
  { q: 'Quali province del Piemonte servite?', a: 'Venere Bagni lavora a Torino e provincia, Cuneo, Novara, Alessandria, Asti, Biella, Vercelli e nel Verbano-Cusio-Ossola. Per sapere se arriviamo nel tuo comune scrivi il CAP nel modulo: la risposta è immediata.' },
];
const reviews = [
  { text: 'Mi hanno misurato il bagno il lunedì e il giovedì avevo già la doccia nuova. Il prezzo era quello scritto sul foglio.', name: 'Maria', town: 'Moncalieri' },
  { text: 'Mia madre non riusciva più a entrare nella vasca. Adesso fa la doccia seduta, da sola, e io sono più tranquillo.', name: 'Giorgio', town: 'Rivoli' },
  { text: 'Sono venuti in due e hanno lavorato tutto il giorno, alla fine il bagno era pulito. Il giorno dopo mi hanno anche telefonato per sapere se andava tutto bene.', name: 'Lucia', town: 'Collegno' },
  { text: 'Volevo solo sapere quanto costava. Il tecnico ha misurato tutto e mi ha lasciato il prezzo senza insistere. Ci sto ancora pensando ma intanto ringrazio.', name: 'Franco', town: 'Carmagnola' },
];
const day = [
  ['8:00', 'Arriva la squadra e protegge casa e pavimenti'],
  ['10:00', 'La vasca è rimossa'],
  ['13:00', 'Piatto doccia e pareti sono montati'],
  ['16:00', 'Box, rubinetteria e accessori sono al loro posto'],
  ['18:00', 'Pulizia finale e consegna'],
];
const prices = [
  ['Vasca in doccia, versione standard', `da ${euro(site.priceFrom)}`],
  ['Vasca in doccia con piatto a filo pavimento', '[DA X €]'],
  ['Vasca con sportello', '[DA X €]'],
  ['Pacchetto bagno sicuro', '[DA X €]'],
];
---
<Base
  title="Vasca in doccia a Torino in 1 giorno | Venere Bagni"
  description="Trasformiamo la vasca in doccia in un giorno, a Torino e in Piemonte. Sopralluogo gratuito a casa tua e preventivo scritto a prezzo fisso, da 3.500 €."
  faqs={faqs}
  service={{ name: 'Trasformazione vasca in doccia', description: site.description, minPrice: site.priceFrom }}
>
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <p class="eyebrow">Torino e tutto il Piemonte</p>
        <h1>Dalla vasca alla doccia in un giorno, a casa tua</h1>
        <p class="lead" set:html={h('Veniamo a casa tua a prendere le misure, senza costi, e ti lasciamo il prezzo scritto. Se il preventivo ti va bene, in un giorno togliamo la vasca e montiamo la doccia [DA CONFERMARE].')} />
        <ul class="chips-row">
          <li><Icon n="check" />Sopralluogo gratuito</li>
          <li><Icon n="check" />Prezzo fisso scritto</li>
          <li><Icon n="check" />Da {euro(site.priceFrom)}</li>
        </ul>
        <p class="trust-line"><span class="stars" aria-hidden="true">★★★★★</span><span set:html={h('[VOTO GOOGLE] su 5 da [N° RECENSIONI] recensioni Google')} /></p>
        <p class="hero__alt" set:html={h(`Preferisci parlare con qualcuno? Chiama il ${site.phone} oppure scrivi su WhatsApp al ${site.whatsappLabel}.`)} />
      </div>
      <div class="hero__media">
        <div class="hero__img"><Image src={media.hero.src} alt={media.hero.alt} widths={[640, 960, 1400]} sizes="(max-width: 960px) 100vw, 560px" loading="eager" fetchpriority="high" /></div>
        <p class="hero__badge">Doccia sicura con seggiolino<span>montata al posto della vasca</span></p>
        <div class="hero__form"><LeadForm id="prenota" /></div>
      </div>
    </div>
  </section>

  <section class="promises" aria-label="Le nostre promesse">
    <div class="wrap">
      <ul>
        <li><Icon n="home" /><div><strong>Sopralluogo gratuito</strong><span>Misuriamo il bagno a casa tua e non paghi niente.</span></div></li>
        <li><Icon n="doc" /><div><strong>Prezzo fisso scritto</strong><span>Il prezzo è nel preventivo e non cambia.</span></div></li>
        <li><Icon n="clock" /><div><strong>Un giorno di lavoro</strong><span set:html={h('La sera puoi già usare la doccia [DA CONFERMARE].')} /></div></li>
        <li><Icon n="shield" /><div><strong set:html={h('Garanzia [ANNI] anni')} /><span>Scritta, su posa e materiali.</span></div></li>
      </ul>
    </div>
  </section>

  <section class="section" id="prima-dopo">
    <div class="wrap">
      <div class="head">
        <h2>Tre bagni in Piemonte, prima e dopo</h2>
        <p class="muted">Sposta la barra su ogni foto per vedere la differenza.</p>
      </div>
      <div class="ba-grid">
        <BeforeAfter before="ba1p" after="ba1d" caption="[CITTÀ] · doccia a piatto basso con panca · [DURATA]" />
        <BeforeAfter before="ba2p" after="ba2d" caption="[CITTÀ] · doccia con porta in vetro e maniglioni · [DURATA]" />
        <BeforeAfter before="ba4p" after="ba4d" caption="[CITTÀ] · doccia walk-in a filo pavimento · [DURATA]" />
      </div>
    </div>
  </section>

  <section class="section section--sand" id="come-funziona">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Come funziona</p>
        <h2>Dalla prima telefonata alla doccia nuova</h2>
      </div>
      <ol class="steps">
        <li><h3>Ci chiami o ci scrivi</h3><p set:html={h('Ci dici il CAP e cosa vuoi cambiare. Ti rispondiamo entro [X ORE].')} /></li>
        <li><h3>Il sopralluogo</h3><p>Un nostro tecnico viene a casa tua, prende le misure e ti fa vedere cosa si può montare nel tuo bagno.</p></li>
        <li><h3>Il preventivo</h3><p>Ti lasciamo un prezzo fisso con l’elenco di quello che comprende. Non devi decidere subito.</p></li>
        <li><h3>Il giorno del lavoro</h3><p>Smontiamo la vasca, posiamo piatto e pareti, montiamo box e rubinetteria e prima di andare via puliamo.</p></li>
      </ol>
      <div class="timeline">
        <h3 set:html={h('La giornata di lavoro, ora per ora [DA CONFERMARE]')} />
        <ol>{day.map(([t, d]) => <li><b>{t}</b><span>{d}</span></li>)}</ol>
      </div>
    </div>
  </section>

  <section class="section" id="soluzioni">
    <div class="wrap">
      <div class="head"><h2>Cosa possiamo mettere al posto della vasca</h2></div>
      <div class="cards">
        <article class="card sol">
          <Image src={media.solDoccia.src} alt={media.solDoccia.alt} widths={[480, 800]} sizes="(max-width: 960px) 100vw, 380px" />
          <div class="sol__body"><h3>Vasca in doccia</h3><p>Dove c’era la vasca mettiamo un piatto doccia, anche a filo pavimento. Il lavoro dura un giorno.</p><a class="link-arrow" href={u('/vasca-in-doccia/')}>Come funziona la trasformazione</a></div>
        </article>
        <article class="card sol">
          <Image src={media.solSportello.src} alt={media.solSportello.alt} widths={[480, 800]} sizes="(max-width: 960px) 100vw, 380px" />
          <div class="sol__body"><h3>Vasca con sportello</h3><p>Per chi il bagno nella vasca lo vuole ancora fare, ma il bordo non riesce più a scavalcarlo. Si entra dallo sportello e ci si siede.</p><a class="link-arrow" href={u('/vasca-con-sportello/')}>La vasca con sportello</a></div>
        </article>
        <article class="card sol">
          <Image src={media.solSicuro.src} alt={media.solSicuro.alt} widths={[480, 800]} sizes="(max-width: 960px) 100vw, 380px" />
          <div class="sol__body"><h3>Bagno sicuro</h3><p>Maniglioni, seggiolino e piatto antiscivolo, messi dove servono a chi userà la doccia. Spesso a chiamarci sono i figli, per un genitore anziano.</p><a class="link-arrow" href={u('/bagno-sicuro/')}>Il bagno sicuro</a></div>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--sand" id="costi">
    <div class="wrap split">
      <div>
        <h2>Quanto costa passare dalla vasca alla doccia</h2>
        <p set:html={h('Una trasformazione standard parte da 3.500 € [DA CONFERMARE: IVA inclusa?]. Quanto spendi alla fine dipende dalla misura del bagno, dal piatto che scegli e dal rivestimento: lo vediamo al sopralluogo e te lo scriviamo nel preventivo.')} />
        <a class="link-arrow" href={u('/prezzi/')}>Listino completo e cosa fa cambiare il prezzo</a>
      </div>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th scope="col">Intervento</th><th scope="col">Prezzo</th></tr></thead>
          <tbody>{prices.map(([a, b]) => <tr><td>{a}</td><td class="num" set:html={h(b)} /></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" id="bonus">
    <div class="wrap narrow">
      <h2>Bonus e detrazioni nel 2026</h2>
      <div class="note"><p set:html={h(bonusShort)} /></div>
      <p style="margin-top:16px"><a class="link-arrow" href={u('/bonus-detrazioni/')}>Le detrazioni 2026 nel dettaglio</a></p>
    </div>
  </section>

  <section class="section section--sand" id="perche">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Perché Venere Bagni</p>
        <h2>Chi viene a casa tua</h2>
        <ul class="ticks">
          <li><span>Dal sopralluogo al collaudo parli sempre con lo stesso responsabile.</span></li>
          <li><span set:html={h('Il lavoro lo fa la nostra squadra di posatori [DA CONFERMARE].')} /></li>
          <li><span>Nel preventivo c’è ogni voce. Se durante il lavoro salta fuori qualcosa che prima non si poteva vedere, ti chiamiamo e ci accordiamo prima di andare avanti.</span></li>
          <li><span>Il tecnico misura e spiega, poi ti lascia il preventivo e decidi tu quando.</span></li>
        </ul>
        <p class="muted" set:html={h('[ANNI DI ESPERIENZA] anni di lavoro e [N° INSTALLAZIONI] bagni rifatti in Piemonte. Su Google abbiamo [VOTO GOOGLE] su 5 da [N° RECENSIONI] clienti, e le recensioni puoi leggerle tutte.')} />
      </div>
      <Image src={media.sopralluogo.src} alt={media.sopralluogo.alt} widths={[640, 960]} sizes="(max-width: 960px) 100vw, 560px" />
    </div>
  </section>

  <section class="section" id="recensioni">
    <div class="wrap">
      <div class="head"><h2>Cosa dicono i clienti</h2><p class="muted" set:html={h('[VOTO GOOGLE] su 5 · [N° RECENSIONI] recensioni su Google')} /></div>
      <Reviews items={reviews} />
    </div>
  </section>

  <section class="section section--sand" id="zone">
    <div class="wrap">
      <div class="head"><h2>Dove lavoriamo</h2><p>Partiamo da Torino, copriamo tutta la provincia e andiamo anche nelle altre province del Piemonte.</p></div>
      <ul class="zones">
        {zones.map((z) => <li><a href={u(`/zone/${z.slug}/`)}>{z.label}</a></li>)}
      </ul>
      <p style="margin-top:20px">La tua zona non c’è? Scrivi il CAP nel modulo e ti diciamo subito se possiamo venire.</p>
    </div>
  </section>

  <section class="section" id="domande">
    <div class="wrap narrow">
      <div class="head"><p class="eyebrow">Domande frequenti</p><h2>Cosa ci chiedono più spesso</h2></div>
      <Faq items={faqs} open />
      <p style="margin-top:20px"><a class="link-arrow" href={u('/domande-frequenti/')}>Tutte le domande</a></p>
    </div>
  </section>

  <CtaBand />
</Base>
