---
import { h, hv } from '../lib/txt';
import type { Faq } from '../lib/schema';
interface Props { items: Faq[]; open?: boolean; verbose?: boolean }
const { items, open = false, verbose = false } = Astro.props;
const t = verbose ? hv : h;
---
<div class="faq">
  {items.map((f, i) => (
    <details open={open && i === 0}>
      <summary set:html={t(f.q)} />
      <div class="ans"><p set:html={t(f.a)} /></div>
    </details>
  ))}
</div>
