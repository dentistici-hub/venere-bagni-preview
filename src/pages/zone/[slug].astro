---
import { isPreview } from '../../lib/url';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import GuideLinks from '../../components/GuideLinks.astro';
import { media } from '../../data/media';
import { ratingValue, ratingCount } from '../../data/site';
import { includedShort } from '../../data/prices';
import { zonePages, type ZonePage } from '../../data/zone-pages';
import { u } from '../../lib/url';
import { hv as h } from '../../lib/txt';

export function getStaticPaths() {
  return zonePages.map((z) => ({ params: { slug: z.slug }, props: { z } }));
}
const { z } = Astro.props as { z: ZonePage };
const crumbs = [{ name: 'Zone', path: '/zone/' }, { name: z.name, path: `/zone/${z.slug}/` }];
const others = zonePages.filter((o) => o.slug !== z.slug);
const m = media[z.img];
---
<Base
  title={z.title}
  description={z.description}
  faqs={z.faqs}
  crumbs={crumbs}
  service={{ name: `Trasformazione vasca in doccia ${z.at}`, description: `Trasformazione della vasca in doccia in provincia ${z.of}, chiavi in mano in 8 ore con i materiali compresi: sopralluogo gratuito e preventivo scritto a prezzo fisso.`, areaServed: z.area }}
>
  <PageHero
    crumbs={crumbs}
    eyebrow={z.eyebrow ?? `${z.name} e provincia`}
    title={`Trasformazione vasca in doccia ${z.at}`}
    lead={z.lead}
    chips={['Sopralluogo gratuito', 'Prezzo fisso scritto', 'Chiavi in mano in 8 ore']}
    img="hero"
    formTitle={`Prenota il sopralluogo gratuito ${z.at}`}
  />

  <section class="section" id="zona">
    <div class="wrap split">
      <div>
        <h2>{z.introTitle}</h2>
        {z.intro.map((p) => <p set:html={h(p)} />)}
        <p class="small" set:html={h(z.realData)} />
      </div>
      <Image src={m.src} alt={m.alt} widths={[640, 960]} sizes="(max-width: 960px) 100vw, 560px" />
    </div>
  </section>

  <section class="section section--sand" id="in-breve">
    <div class="wrap narrow">
      <h2>La provincia {z.of} in breve</h2>
      <div class="tbl-wrap">
        <table class="tbl">
          <tbody>{z.facts.map(([a, b]) => <tr><th scope="row">{a}</th><td set:html={h(b)} /></tr>)}</tbody>
        </table>
      </div>
      <p style="margin-top:20px" set:html={h(z.l13)} />
      <p class="muted">Il contributo della legge 13 è per persone con disabilità motoria o non vedenti che abitano nella casa dei lavori. La domanda va fatta prima di cominciare, in qualsiasi giorno dell’anno, e i soldi arrivano a lavori finiti. <a href={u('/bonus-detrazioni/')}>Regole e detrazioni 2026</a>.</p>
    </div>
  </section>

  <section class="section" id="comuni">
    <div class="wrap narrow">
      <h2>Dove lavoriamo in provincia {z.of}</h2>
      {z.slug === 'torino' && <p>Torino città e, in provincia:</p>}
      <div class="tbl-wrap">
        <table class="tbl">
          <caption>Comuni serviti da Venere Bagni in provincia {z.of}</caption>
          <thead><tr><th scope="col">Zona</th><th scope="col">Comuni</th></tr></thead>
          <tbody>{z.towns.map(([a, b]) => <tr><th scope="row">{a}</th><td>{b}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="small" set:html={h('[DA CONFERMARE: elenco definitivo dei comuni serviti]')} />
      <p>Il tuo comune non c’è? Scrivi il CAP nel modulo e ti diciamo subito se possiamo venire.</p>
    </div>
  </section>

  <section class="section section--sand" id="prezzo">
    <div class="wrap narrow">
      <h2>{z.pricesTitle}</h2>
      <div class="note">
        <p set:html={h(z.prices)} />
        <p>Il lavoro comprende {includedShort}.</p>
        <p><a class="link-arrow" href={u('/prezzi/')}>Da cosa dipende il prezzo</a></p>
      </div>
    </div>
  </section>

  {isPreview && <section class="section" id="recensioni">
    <div class="wrap">
      <div class="head"><h2>Cosa dicono i clienti{z.slug === 'torino' ? ' di Torino' : ''}</h2>
        {z.rating && <p class="muted" set:html={h(`Valutazione Google: ${ratingValue} su 5, ${ratingCount} recensioni.`)} />}
      </div>
      <figure class="review card review--solo">
        <span class="stars" aria-label="5 stelle su 5">★★★★★</span>
        <blockquote set:html={h(z.review.text)} />
        <footer>{z.review.name}<span>{z.review.town} · <mark class="ph ph--label">recensione di esempio</mark></span></footer>
      </figure>
    </div>
  </section>}

  <section class="section section--sand" id="domande">
    <div class="wrap narrow">
      <div class="head"><p class="eyebrow">Domande frequenti</p><h2>Domande frequenti {z.at}</h2></div>
      <Faq items={z.faqs} open verbose />
      <p style="margin-top:28px" class="muted">{z.slug === 'torino' ? 'Oltre a Torino e provincia lavoriamo in tutto il Piemonte' : 'Partiamo da Torino e lavoriamo anche nelle altre province del Piemonte'}: {others.map((o, i) => <>{i > 0 && (i === others.length - 1 ? ' e ' : ', ')}<a href={u(`/zone/${o.slug}/`)}>{o.name}</a></>)}.</p>
    </div>
  </section>

  <GuideLinks />

  <CtaBand title={`Prenota il sopralluogo gratuito ${z.at}`} text="Un tecnico viene a casa tua a prendere le misure e ti lascia il preventivo scritto, a prezzo fisso." />
</Base>
