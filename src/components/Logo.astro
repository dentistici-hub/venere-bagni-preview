---
// Venere Bagni logo, vector rebuild of the client's logo (client data/italprogetti/brand/venere-bagni-logo-originale.jpg).
// Fonts converted to paths (VENERE: Cinzel 700, BAGNI: Marcellus SC), so no extra webfont is loaded.
// variant "chip": on a small marble plate with the original's drop shadow (white letters need it on light backgrounds).
// variant "plain": no plate, for dark backgrounds (footer).
import { site } from '../data/site';
import { u } from '../lib/url';
interface Props { variant?: 'chip' | 'plain' }
const { variant = 'chip' } = Astro.props;
const chip = variant === 'chip';
