---
// Small hub for the "Zone" breadcrumb level; text reused from the home page zone section.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site, zones } from '../../data/site';
import { u } from '../../lib/url';

const crumbs = [{ name: 'Zone', path: '/zone/' }];
---
<Base
  title="Zone servite in Piemonte | Venere Bagni"
  description="Trasformazione vasca in doccia a Torino, Cuneo, Novara e nelle altre province del Piemonte. Sopralluogo gratuito e preventivo scritto a prezzo fisso."
  crumbs={crumbs}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Zone servite"
    title="Lavoriamo in tutto il Piemonte"
    lead="Partiamo da Torino e dalla sua provincia e arriviamo nelle altre province."
    formTitle="Verifichiamo se la sua zona è servita"
  >
    <ul class="zones">
      {zones.map((z) => <li><a href={u(`/zone/${z.slug}/`)}>{z.name} e provincia</a></li>)}
      {site.areas.filter((a) => !zones.some((z) => z.name === a)).map((a) => <li><span>{a}</span></li>)}
    </ul>
    <p style="margin-top:20px">Non vede la sua zona? Scriva il CAP nel modulo e Le diciamo subito se possiamo venire.</p>
  </PageHero>

  <CtaBand />
</Base>
