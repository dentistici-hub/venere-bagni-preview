---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { bonusFaq } from '../data/bonus';
import { u } from '../lib/url';

const crumbs = [{ name: 'Domande frequenti', path: '/domande-frequenti/' }];
const groups = [
  { id: 'lavori', title: 'Lavori', items: [
    { q: 'Cosa significa trasformare la vasca in doccia?', a: 'Trasformare la vasca in doccia significa togliere la vasca e montare nello stesso spazio un piatto doccia con pareti e box. Venere Bagni lo fa senza abbattere muri e senza rifare l’intero bagno. Il resto del locale resta com’è.' },
    { q: 'Devo togliere le piastrelle?', a: 'Di solito le piastrelle fuori dallo spazio della vasca restano. Venere Bagni riveste l’area della doccia con pareti sintetiche montate sopra o al posto delle piastrelle esistenti, secondo lo stato del muro. Al sopralluogo Le diciamo cosa succede nel suo bagno.' },
    { q: 'Si può fare in un condominio?', a: 'Sì. Il lavoro riguarda l’interno del suo appartamento. Venere Bagni avvisa l’amministratore se serve e protegge scale e ascensore.' },
    { q: 'Cosa succede ai miei mobili e ai miei pavimenti?', a: 'Venere Bagni protegge i pavimenti con teli e cartoni dal portone al bagno. Chiediamo solo di togliere gli oggetti personali dal bagno e di liberare il corridoio. A fine giornata puliamo e portiamo via le macerie.' },
  ] },
  { id: 'prezzi', title: 'Prezzi', items: [
    { q: 'Quanto costa trasformare la vasca in doccia?', a: 'Una trasformazione standard con Venere Bagni parte da 3.500 € [DA CONFERMARE: IVA inclusa?]. Il prezzo finale dipende da misura, piatto e finiture, ed è fissato nel preventivo scritto dopo il sopralluogo gratuito.' },
    { q: 'Il prezzo del preventivo può cambiare?', a: 'No. Venere Bagni lavora a prezzo fisso. Se emerge un problema nascosto, come uno scarico danneggiato, Le spieghiamo la situazione e concordiamo con Lei l’eventuale costo prima di intervenire.' },
    { q: 'Si può pagare a rate?', a: '[DA CONFERMARE: finanziamento disponibile?] Venere Bagni propone il pagamento a rate tramite [SOCIETÀ DI FINANZIAMENTO]. Le condizioni si definiscono al sopralluogo e sono scritte nel preventivo.' },
  ] },
  { id: 'tempi', title: 'Tempi', items: [
    { q: 'Quanto dura il lavoro?', a: 'Il lavoro di trasformazione della vasca in doccia con Venere Bagni dura un giorno [DA CONFERMARE]. La squadra arriva la mattina e la sera la doccia è pronta. Per casi particolari, come il filo pavimento con scarico da rifare, Le diciamo i tempi nel preventivo.' },
    { q: 'Tra la richiesta e il lavoro quanto devo aspettare?', a: 'Le rispondiamo entro [X ORE]. Il sopralluogo si fissa di solito entro [X GIORNI] e il lavoro inizia [X GIORNI] dopo l’accettazione del preventivo [DA CONFERMARE].' },
    { q: 'Posso usare il bagno durante il lavoro?', a: 'No, per quella giornata il bagno è chiuso. Se ha un secondo bagno in casa, nessun problema. Altrimenti ne parliamo al sopralluogo e cerchiamo la soluzione che Le crea meno disagio.' },
  ] },
  { id: 'sicurezza', title: 'Sicurezza', items: [
    { q: 'La doccia nuova è più sicura della vasca?', a: 'Per chi ha difficoltà a muoversi, sì. Un piatto doccia di Venere Bagni a filo pavimento non ha il bordo da scavalcare e ha un fondo antiscivolo. Si possono aggiungere maniglioni e seggiolino, che riducono molto il rischio di cadere.' },
    { q: 'Il piatto è scivoloso?', a: 'Il piatto doccia di Venere Bagni ha una superficie antiscivolo [DA CONFERMARE: classe di antiscivolo del catalogo]. Resta aderente anche con acqua e sapone, e si pulisce con un panno.' },
    { q: 'Si può usare con la sedia da doccia o il deambulatore?', a: 'Con il piatto a filo pavimento sì, perché non c’è scalino. Venere Bagni misura la larghezza del passaggio al sopralluogo e Le dice se il suo ausilio entra comodamente.' },
  ] },
  { id: 'sopralluogo', title: 'Sopralluogo', items: [
    { q: 'Il sopralluogo è gratuito davvero?', a: 'Sì. Il sopralluogo di Venere Bagni è gratuito e senza impegno. Un tecnico viene a casa sua, misura il bagno e Le consegna un preventivo scritto. Se non accetta, non paga nulla.' },
    { q: 'Quanto dura il sopralluogo e chi viene?', a: 'Dura circa [DURATA] minuti. Viene un tecnico di Venere Bagni [DA CONFERMARE: nome e ruolo], che è anche la persona che segue il suo lavoro fino alla fine. Può essere presente anche un familiare.' },
    { q: 'Se non compro, mi richiamate in continuazione?', a: 'No. Dopo il sopralluogo Le consegniamo il preventivo e Le lasciamo il tempo di decidere. Chiamiamo una volta per sapere se ha domande, se Lei è d’accordo. Poi la scelta è sua.' },
  ] },
  { id: 'garanzia', title: 'Garanzia', items: [
    { q: 'Che garanzia date sul lavoro?', a: 'Venere Bagni dà una garanzia di [ANNI DI GARANZIA] anni sulla posa e sui materiali, scritta nel contratto. Se c’è un difetto di montaggio o una perdita nel periodo di garanzia, torniamo a sistemarlo senza costi per Lei [DA CONFERMARE: condizioni].' },
    { q: 'A chi mi rivolgo se ho un problema dopo il lavoro?', a: `Alla stessa persona che l’ha seguita dall’inizio. Il suo referente di Venere Bagni ha il suo numero e Lei il suo. Chiami il ${site.phone} oppure scriva su WhatsApp al ${site.whatsappLabel}: [DA CONFERMARE: tempi di intervento in garanzia].` },
  ] },
  { id: 'bonus', title: 'Bonus e detrazioni', items: bonusFaq },
];
const faqs = groups.flatMap((g) => g.items);
---
<Base
  title="Domande su vasca in doccia e bagno sicuro | Venere Bagni"
  description="Risposte su lavori, prezzi, tempi, sicurezza, sopralluogo e garanzia per trasformare la vasca in doccia in Piemonte."
  faqs={faqs.filter((f) => !f.a.includes('[SOCIETÀ DI FINANZIAMENTO]'))}
  crumbs={crumbs}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Domande frequenti"
    title="Domande frequenti sulla trasformazione vasca in doccia"
    lead={`Le risposte alle domande che ci fanno più spesso a Torino e in Piemonte. Non trova la sua? Chiami il ${site.phone}.`}
    contacts={false}
  >
    <p class="muted" style="margin-bottom:12px">Vada subito all’argomento:</p>
    <ul class="zones">{groups.map((g) => <li><a href={`#${g.id}`}>{g.title}</a></li>)}</ul>
  </PageHero>

  {groups.map((g, i) => (
    <section class={`section${i % 2 ? ' section--sand' : ''}`} id={g.id} style="padding-block: clamp(40px, 5vw, 72px)">
      <div class="wrap narrow">
        <h2>{g.title}</h2>
        <Faq items={g.items} verbose />
        {g.id === 'bonus' && <p style="margin-top:20px"><a class="link-arrow" href={u('/bonus-detrazioni/')}>Tutto sulle detrazioni 2026</a></p>}
        {g.id === 'prezzi' && <p style="margin-top:20px"><a class="link-arrow" href={u('/prezzi/')}>Vede tutti i prezzi</a></p>}
      </div>
    </section>
  ))}

  <CtaBand title="Ha ancora un dubbio?" text="Ce lo chieda al telefono o al sopralluogo gratuito." />
</Base>
