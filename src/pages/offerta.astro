---
// Ads landing: no navigation (Base landing), noindex, form above the fold on mobile.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import RealWork from '../components/RealWork.astro';
import Faq from '../components/Faq.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { media } from '../data/media';
import { site, ratingValue, ratingCount } from '../data/site';
import { hv as h } from '../lib/txt';

const faqs = [
  { q: 'Quanto costa trasformare la vasca in doccia?', a: 'Dipende dalla misura del bagno, dal piatto, dal gres e dal box che scegli, quindi il prezzo te lo diamo dopo aver visto il bagno. Venere Bagni viene a misurare gratis e ti lascia un preventivo scritto a prezzo fisso. Dentro c’è tutto il lavoro: vasca tolta e smaltita, impianto, massetto, piatto, box, rubinetteria, rivestimento in gres, finiture e materiali.' },
  { q: 'Quanto dura il lavoro?', a: '8 ore, chiavi in mano. La squadra di Venere Bagni arriva la mattina con tutto il materiale, toglie la vasca e la porta via, rifà impianto e massetto, posa il piatto, riveste le pareti in gres, monta box e rubinetteria e pulisce. Non devi comprare niente tu, e la sera la doccia si può già usare.' },
  { q: 'Il sopralluogo mi impegna?', a: 'No. Il sopralluogo di Venere Bagni è gratuito e non ti impegna. Ti lasciamo il preventivo e decidi tu quando.' },
  { q: 'Lavorate anche nella mia zona?', a: 'Venere Bagni lavora a Torino e in tutta la provincia, dalla cintura al Canavese, al Pinerolese e alle valli, e arriva anche nelle altre province del Piemonte. Scrivi il CAP nel modulo e ti diciamo subito se veniamo da te.' },
];
const reviews = [
  { text: 'Arrivati la mattina, nel pomeriggio avevano finito. Il prezzo era quello scritto.', name: 'Maria', town: 'Moncalieri' },
  { text: 'Mia madre ora fa la doccia seduta e da sola.', name: 'Giorgio', town: 'Rivoli' },
  { text: 'Hanno lasciato il bagno pulito e mi hanno richiamata dopo.', name: 'Lucia', town: 'Collegno' },
];
---
<Base
  title="Vasca in doccia in 8 ore | Offerta Venere Bagni"
  description="Sostituisci la vasca con la doccia in 8 ore, materiali compresi. Sopralluogo gratuito a Torino e in Piemonte e preventivo a prezzo fisso."
  landing
  noindex
>
  <p class="offer-band" set:html={h('[OFFERTA DEL MESE: DA DEFINIRE, scadenza gg/mm]')} />

  <section class="lp-hero">
    <div class="wrap lp-hero__grid">
      <div class="lp-hero__text">
        <h1>Sostituisci la vasca con la doccia in 8 ore</h1>
        <p class="lead">Veniamo a casa tua, a Torino o in provincia, a misurare il bagno senza costi e ti lasciamo un preventivo scritto a prezzo fisso. Il lavoro è chiavi in mano.</p>
      </div>
      <div class="lp-hero__form"><LeadForm id="prenota" title="Prenota il sopralluogo gratuito" /></div>
        <div class="lp-hero__more">
          <ul class="chips-row">
            <li><Icon n="check" />Sopralluogo gratuito</li>
            <li><Icon n="check" />Prezzo fisso scritto</li>
            <li><Icon n="check" />Chiavi in mano in 8 ore</li>
          </ul>
          <p class="trust-line"><span class="stars" aria-hidden="true">★★★★★</span><span set:html={h(`${ratingValue} su 5 da ${ratingCount} recensioni Google`)} /></p>
          <p class="hero__alt" set:html={h(`Preferisci telefonare? Chiama il ${site.phone}.`)} />
          <div class="lp-hero__img"><Image src={media.hero.src} alt={media.hero.alt} widths={[640, 960, 1400]} sizes="(max-width: 960px) 100vw, 560px" /></div>
        </div>
    </div>
  </section>

  <section class="promises promises--3" aria-label="Perché sceglierci">
    <div class="wrap">
      <ul>
        <li><Icon n="home" /><div><strong>Sopralluogo gratuito</strong><span>Misuriamo a casa tua e non paghi niente.</span></div></li>
        <li><Icon n="doc" /><div><strong>Prezzo fisso scritto</strong><span>Sai quanto spendi prima di decidere.</span></div></li>
        <li><Icon n="clock" /><div><strong>8 ore, chiavi in mano</strong><span>I materiali li portiamo noi. La sera la doccia è pronta.</span></div></li>
      </ul>
    </div>
  </section>

  <section class="section" id="prima-dopo">
    <div class="wrap">
      <div class="head head--row">
        <h2>Bagni veri, prima e dopo</h2>
        <p class="muted">Sposta la barra su ogni foto per vedere la differenza.</p>
      </div>
      <RealWork />
    </div>
  </section>

  <section class="section section--sand" id="come-funziona">
    <div class="wrap">
      <div class="head"><h2>Come funziona</h2></div>
      <ol class="steps">
        <li><h3>Ci lasci CAP e telefono</h3><p set:html={h('Ti richiamiamo entro [X ORE].')} /></li>
        <li><h3>Veniamo a misurare, gratis</h3><p>Ti facciamo vedere cosa si può montare nel tuo bagno.</p></li>
        <li><h3>Ti lasciamo il preventivo scritto</h3><p>Il prezzo è fisso e non devi decidere subito.</p></li>
        <li><h3>Facciamo il lavoro in 8 ore</h3><p>Chiavi in mano, materiali compresi. La sera usi già la doccia nuova.</p></li>
      </ol>
    </div>
  </section>

  <section class="section" id="recensioni">
    <div class="wrap">
      <div class="head"><h2>Cosa dicono i clienti</h2><p class="muted" set:html={h(`${ratingValue} su 5 · ${ratingCount} recensioni su Google`)} /></div>
      <Reviews items={reviews} />
    </div>
  </section>

  <section class="section section--sand" id="domande">
    <div class="wrap narrow">
      <div class="head"><p class="eyebrow">Domande frequenti</p><h2>Prima di prenotare</h2></div>
      <Faq items={faqs} open verbose />
    </div>
  </section>

  <CtaBand title="Prenota il sopralluogo gratuito" text="Lasciaci il CAP e un numero di telefono. Un nostro tecnico ti chiama per fissare il sopralluogo quando ti fa comodo." />
</Base>
