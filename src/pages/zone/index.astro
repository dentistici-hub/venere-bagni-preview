---
// Small hub for the "Zone" breadcrumb level; text reused from the home page zone section.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site, zones } from '../../data/site';
import { u } from '../../lib/url';

const crumbs = [{ name: 'Zone', path: '/zone/' }];
---
<Base
  title="Zone servite in Piemonte | Venere Bagni"
  description="Trasformazione vasca in doccia nelle 8 province del Piemonte, da Torino al Verbano-Cusio-Ossola. Sopralluogo gratuito e preventivo scritto a prezzo fisso."
  crumbs={crumbs}
  pageType="CollectionPage"
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Zone servite"
    title="Lavoriamo in tutto il Piemonte"
    lead="Partiamo da Torino e lavoriamo in tutte le otto province del Piemonte. Ogni provincia ha la sua pagina, con i comuni, i CAP e dove si chiede il contributo della legge 13."
    formTitle="Vediamo se arriviamo nella tua zona"
  >
    <ul class="zones">
      {zones.map((z) => <li><a href={u(`/zone/${z.slug}/`)}>{z.label}</a></li>)}
    </ul>
    <p style="margin-top:20px">La tua zona non c’è? Scrivi il CAP nel modulo e ti diciamo subito se possiamo venire.</p>
  </PageHero>

  <CtaBand />
</Base>
