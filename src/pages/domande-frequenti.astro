---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import GuideLinks from '../components/GuideLinks.astro';
import { site } from '../data/site';
import { faqGroups } from '../data/faq';
import { u } from '../lib/url';

const crumbs = [{ name: 'Domande frequenti', path: '/domande-frequenti/' }];
const groups = faqGroups;
const faqs = groups.flatMap((g) => g.items);
---
<Base
  title="Domande su vasca in doccia e bagno sicuro | Venere Bagni"
  description="Risposte su lavori, prezzi, tempi, sicurezza, sopralluogo e garanzia per trasformare la vasca in doccia a Torino e provincia."
  faqs={faqs.filter((f) => !f.a.includes('[SOCIETÀ DI FINANZIAMENTO]'))}
  crumbs={crumbs}
  pageType="FAQPage"
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Domande frequenti"
    title="Domande frequenti sulla trasformazione vasca in doccia"
    lead={`Le domande che ci fanno più spesso a Torino e provincia. Se la tua non c’è, chiama il ${site.phone}.`}
    contacts={false}
  >
    <p class="muted" style="margin-bottom:12px">Vai all’argomento:</p>
    <ul class="zones">{groups.map((g) => <li><a href={`#${g.id}`}>{g.title}</a></li>)}</ul>
  </PageHero>

  {groups.map((g, i) => (
    <section class={`section${i % 2 ? ' section--sand' : ''}`} id={g.id} style="padding-block: clamp(40px, 5vw, 72px)">
      <div class="wrap narrow">
        <h2>{g.title}</h2>
        <Faq items={g.items} verbose />
        {g.id === 'bonus' && <p style="margin-top:20px"><a class="link-arrow" href={u('/bonus-detrazioni/')}>Le detrazioni 2026 nel dettaglio</a></p>}
        {g.id === 'prezzi' && <p style="margin-top:20px"><a class="link-arrow" href={u('/prezzi/')}>Tutti i prezzi</a></p>}
      </div>
    </section>
  ))}

  <GuideLinks sand />

  <CtaBand title="Hai ancora un dubbio?" text="Chiedicelo al telefono o al sopralluogo gratuito." />
</Base>
