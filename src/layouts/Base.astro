---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import '../styles/global.css';
import fs from 'node:fs';
import path from 'node:path';
import { site, filled } from '../data/site';
import { pageUpdated } from '../data/dates.mjs';
import { buildGraph, abs, type Faq, type PageType, type ServiceOpts } from '../lib/schema';
import { u, isPreview } from '../lib/url';
import { plain } from '../lib/txt';
import Consent from '../components/Consent.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';

interface Props {
  title?: string; description?: string; faqs?: Faq[]; crumbs?: { name: string; path: string }[];
  service?: ServiceOpts; landing?: boolean; noindex?: boolean; pageType?: PageType;
  noForm?: boolean; // page has no lead form with id="prenota": header and mobile buttons go to the home page form
  // Guides: Article schema + og:type article. Dates YYYY-MM-DD.
  article?: { headline: string; published: string };
}
const { title = site.title, description = site.description, faqs, crumbs, service, landing = false, noindex = false, pageType, article, noForm = false } = Astro.props;
const formHref = noForm ? u('/#prenota') : '#prenota';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pagePath = Astro.url.pathname.slice(base.length) || '/';
const canonical = abs(pagePath);
// Per-page social image public/og/<key>.jpg (made by scripts/make-og.py), key = path with "/" -> "-", "home" for "/".
const ogKey = pagePath === '/' ? 'home' : pagePath.replace(/^\/|\/$/g, '').replace(/\//g, '-');
const ogFile = fs.existsSync(path.join(process.cwd(), 'public', 'og', `${ogKey}.jpg`)) ? `/og/${ogKey}.jpg` : site.ogImage;
const ogImage = abs(ogFile);
const modified = pageUpdated(pagePath);
const graph = JSON.stringify(buildGraph({
  path: pagePath, title, description, image: ogImage, modified, pageType, faqs, crumbs, service,
  article: article ? { headline: article.headline, published: article.published, modified } : undefined,
}));
const index = site.indexable && !noindex && !isPreview;
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{plain(title)}</title>
    <meta name="description" content={plain(description)} />
    <meta name="theme-color" content="#0a3843" />
    <meta name="robots" content={index ? 'index, follow, max-image-preview:large, max-snippet:-1' : 'noindex, nofollow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={plain(title)} />
    <meta property="og:description" content={plain(description)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={plain(title)} />
    {article && <meta property="article:published_time" content={article.published} />}
    {article && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={plain(title)} />
    <meta name="twitter:description" content={plain(description)} />
    <meta name="twitter:image" content={ogImage} />
    {filled(site.googleVerification) && <meta name="google-site-verification" content={site.googleVerification} />}
    {filled(site.bingVerification) && <meta name="msvalidate.01" content={site.bingVerification} />}
    <link rel="alternate" type="text/plain" href={u('/llms.txt')} title="llms.txt" />
    <link rel="sitemap" type="application/xml" href={u('/sitemap-index.xml')} />
    <script type="application/ld+json" set:html={graph} />
    {/* Presentation mode (preview only): example data on by default, choice remembered. Set before paint. */}
    {isPreview && (
      <script is:inline>(function(){var on=true;try{on=localStorage.getItem('venere-ex')!=='0'}catch(e){}if(on)document.documentElement.classList.add('pv-ex');document.documentElement.classList.add('pv')})();</script>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Vai al contenuto</a>
    {isPreview && (
      <div class="preview-ribbon">
        <p><strong>Anteprima del progetto</strong><span class="pv-desc"><span class="pv-when-ex"> · foto e dati di esempio, non reali</span><span class="pv-when-ph"> · foto di esempio e dati da confermare (evidenziati in giallo)</span> · il modulo non invia dati</span></p>
        <button type="button" class="pv-toggle" data-pv-toggle hidden><span class="pv-when-ph">Mostra dati di esempio</span><span class="pv-when-ex">Mostra cosa manca</span></button>
      </div>
    )}
    <Header minimal={landing} formHref={formHref} />
    <main id="main"><slot /></main>
    <Footer minimal={landing} />
    <MobileBar formHref={formHref} />
    <Consent />
    {/* Swaps each placeholder mark between its name and its example value (data-ex). Inline at the end of <body>
        so the example text is in place before the first paint. "a|b|c" values rotate on the page. */}
    {isPreview && (
      <script is:inline>(function(){
        var root=document.documentElement,marks=[].slice.call(document.querySelectorAll('mark.ph[data-ex]')),seen={};
        marks.forEach(function(m){var k=m.textContent,alts=m.getAttribute('data-ex').split('|');m.setAttribute('data-ph',k);seen[k]=(seen[k]||0)+1;m.setAttribute('data-ex-v',alts[(seen[k]-1)%alts.length]);});
        function apply(){var on=root.classList.contains('pv-ex');marks.forEach(function(m){m.textContent=on?m.getAttribute('data-ex-v'):m.getAttribute('data-ph');});}
        apply();
        var b=document.querySelector('[data-pv-toggle]');if(!b)return;b.hidden=false;
        b.addEventListener('click',function(){var on=root.classList.toggle('pv-ex');try{localStorage.setItem('venere-ex',on?'1':'0')}catch(e){}apply();});
      })();</script>
    )}
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
