---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { media } from '../data/media';
import { site, euro } from '../data/site';
import { u } from '../lib/url';
import { hv as h } from '../lib/txt';

const crumbs = [{ name: 'Vasca in doccia', path: '/vasca-in-doccia/' }];
const incluso = [
  ['Rimozione', 'Smontiamo la vasca e portiamo via le macerie'],
  ['Piatto doccia', 'Lo posiamo con le pendenze corrette per lo scarico'],
  ['Pareti', 'Montiamo pareti in materiale sintetico, senza fughe da pulire'],
  ['Box doccia', 'Anta scorrevole o a battente, secondo il suo bagno'],
  ['Rubinetteria', 'Miscelatore, soffione e doccino'],
  ['Accessori di sicurezza', 'Maniglione e seggiolino, se li vuole'],
  ['Pulizia', 'Lasciamo il bagno pulito a fine giornata'],
];
const day = [
  ['8:00', 'La squadra arriva, protegge pavimenti e corridoio'],
  ['9:00', 'Smontaggio e rimozione della vasca'],
  ['11:00', 'Preparazione del fondo e posa dello scarico'],
  ['13:00', 'Posa del piatto doccia'],
  ['14:30', 'Montaggio delle pareti'],
  ['16:00', 'Box doccia, rubinetteria, accessori'],
  ['18:00', 'Pulizia, prova dell’acqua e consegna'],
];
const faqs = [
  { q: 'Quanto dura la trasformazione della vasca in doccia?', a: 'La trasformazione della vasca in doccia di Venere Bagni dura un giorno di lavoro [DA CONFERMARE]. Si parte la mattina presto e la sera la doccia è pronta all’uso. Il sopralluogo, che viene prima, richiede circa [DURATA] minuti a casa sua.' },
  { q: 'Si può fare in un bagno piccolo?', a: 'Sì. La doccia al posto della vasca occupa lo stesso spazio e spesso ne libera un po’, perché le pareti sono più sottili. Venere Bagni misura il bagno al sopralluogo gratuito e Le dice quale piatto entra, anche nei bagni stretti dei condomini di Torino.' },
  { q: 'La doccia nuova è facile da pulire e tiene l’acqua?', a: 'Venere Bagni posa pareti sintetiche senza fughe tra le piastrelle, quindi si puliscono con un panno [DA CONFERMARE: materiale pareti]. Il piatto è sigillato e la tenuta è coperta dalla garanzia di [ANNI DI GARANZIA] anni.' },
  { q: 'Devo svuotare il bagno prima?', a: 'Basta liberare la zona intorno alla vasca e togliere gli oggetti personali. La squadra di Venere Bagni protegge il resto della casa con teli e cartoni, e a fine giornata pulisce.' },
  { q: 'Si può avere una doccia con seggiolino e maniglione?', a: 'Sì. Venere Bagni monta seggiolino ribaltabile e maniglioni nello stesso intervento. Sono utili per chi ha più di 65 anni o per chi ha difficoltà di equilibrio. Se Le interessa, veda la pagina sul bagno sicuro.' },
];
---
<Base
  title="Trasformazione vasca in doccia in 1 giorno | Venere Bagni"
  description="Da vasca a doccia in un giorno, a Torino e in Piemonte. Che cosa è compreso, quanto costa e come si svolge la giornata di lavoro."
  faqs={faqs}
  crumbs={crumbs}
  service={{ name: 'Trasformazione vasca in doccia', description: 'Sostituzione della vasca con un piatto doccia nello stesso spazio, con pareti, box e rubinetteria, in un giorno di lavoro, a Torino e in Piemonte.', minPrice: site.priceFrom }}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Torino e tutto il Piemonte"
    title="Trasformazione della vasca in doccia in un giorno"
    lead="Togliamo la vasca e al suo posto montiamo una doccia comoda e sicura. Il lavoro dura una giornata [DA CONFERMARE] e il prezzo è scritto prima di iniziare."
    chips={['Sopralluogo gratuito', 'Prezzo fisso scritto', `Da ${euro(site.priceFrom)}`]}
    img="solDoccia"
    formTitle="Prenoti il sopralluogo gratuito"
  />

  <section class="section" id="cos-e">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Che cos’è</p>
        <h2>La doccia nuova, nello spazio della vecchia vasca</h2>
        <p>La trasformazione vasca in doccia sostituisce la vasca con un piatto doccia nello stesso spazio. Non si abbattono muri e non si rifà tutto il bagno. Si lavora nell’ingombro della vasca, che spesso in un condominio degli anni ’60 e ’70 misura circa 170 cm.</p>
        <p>Chi la sceglie di solito ha un motivo preciso: scavalcare il bordo è diventato faticoso, la vasca non si usa più da anni, oppure serve spazio. Con la doccia si entra con un passo basso e si lava senza fatica.</p>
      </div>
      <Image src={media.luminoso.src} alt={media.luminoso.alt} widths={[640, 960]} sizes="(max-width: 960px) 100vw, 560px" />
    </div>
  </section>

  <section class="section section--sand" id="incluso">
    <div class="wrap narrow">
      <p class="eyebrow">Che cosa è compreso</p>
      <h2>Ogni voce è scritta nel preventivo</h2>
      <p>Il preventivo di Venere Bagni elenca ogni voce. Nel lavoro standard sono comprese:</p>
      <div class="tbl-wrap">
        <table class="tbl">
          <caption>Che cosa comprende la trasformazione standard</caption>
          <thead><tr><th scope="col">Voce</th><th scope="col">Cosa facciamo</th></tr></thead>
          <tbody>{incluso.map(([a, b]) => <tr><th scope="row">{a}</th><td>{b}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="small" set:html={h('[DA CONFERMARE: elenco esatto delle voci incluse nel prezzo da 3.500 €]')} />
    </div>
  </section>

  <section class="section" id="scelte">
    <div class="wrap split">
      <Image src={media.classico.src} alt={media.classico.alt} widths={[640, 960]} sizes="(max-width: 960px) 100vw, 560px" />
      <div>
        <p class="eyebrow">Cosa può scegliere</p>
        <h2>Piatto, finiture e box, secondo il suo bagno</h2>
        <p><strong>Il piatto.</strong> Può essere a filo pavimento, senza scalino, oppure con bordo basso. Il filo pavimento è la scelta più comoda per chi ha problemi di equilibrio o userà una sedia da doccia. Costa di più e richiede più attenzione allo scarico, che verifichiamo al sopralluogo.</p>
        <p set:html={h('**Colori e finiture.** [OPZIONI DA CATALOGO: colori e finiture delle pareti, colori del piatto, tipi di box, rubinetteria]')} />
        <p set:html={h('**Il box.** [OPZIONI DA CATALOGO: scorrevole, a battente, a nicchia]')} />
      </div>
    </div>
  </section>

  <section class="section section--sand" id="giornata">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Il giorno del lavoro</p>
        <h2>La giornata di lavoro, ora per ora</h2>
        <p set:html={h('La giornata tipo è questa [DA CONFERMARE: orari tipici].')} />
      </div>
      <div class="timeline timeline--7">
        <ol>{day.map(([t, d]) => <li><b>{t}</b><span>{d}</span></li>)}</ol>
      </div>
      <p class="sec-intro" style="margin-top:24px">Durante il lavoro in casa Le serve solo un posto dove ci si può cambiare e un bagno alternativo per la giornata, se ne ha un secondo. Se non ce l’ha, ne parliamo al sopralluogo.</p>
    </div>
  </section>

  <section class="section" id="prezzo">
    <div class="wrap narrow">
      <p class="eyebrow">Quanto costa</p>
      <h2>Il prezzo, prima di iniziare</h2>
      <div class="price-box">
        <p class="from"><small>Prezzo a partire da</small>{euro(site.priceFrom)}</p>
        <div>
          <p set:html={h('Una trasformazione standard parte da 3.500 € [DA CONFERMARE: IVA inclusa?]. Il prezzo dipende dalla misura, dal tipo di piatto e dalle finiture. Dettaglio completo nella pagina prezzi.')} />
          <a class="link-arrow" href={u('/prezzi/')}>Vede tutti i prezzi</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sand" id="domande">
    <div class="wrap narrow">
      <div class="head"><p class="eyebrow">Domande frequenti</p><h2>Domande sulla trasformazione vasca in doccia</h2></div>
      <Faq items={faqs} open verbose />
      <p style="margin-top:20px"><a class="link-arrow" href={u('/bagno-sicuro/')}>Il bagno sicuro con seggiolino e maniglioni</a></p>
    </div>
  </section>

  <CtaBand title="Prenoti il sopralluogo gratuito" text="Misuriamo il bagno a casa sua e Le lasciamo un preventivo scritto. Nessun obbligo." />
</Base>
