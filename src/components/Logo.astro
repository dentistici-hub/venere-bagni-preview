---
// Venere Bagni logo: layout of the client's logo (client data/italprogetti/brand/venere-bagni-logo-originale.jpg),
// set in the site's own fonts as paths (VENERE: Fraunces 720 opsz 144, BAGNI: Atkinson Hyperlegible 700), so no extra font loads.
// Tricolour lightened for dark backgrounds. variant "chip": on a petrol plate (header); "plain": no plate (footer, already petrol).
import { site } from '../data/site';
import { u } from '../lib/url';
interface Props { variant?: 'chip' | 'plain' }
const { variant = 'chip' } = Astro.props;
---
