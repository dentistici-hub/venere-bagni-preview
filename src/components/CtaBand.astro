---
import { site, filled } from '../data/site';
import { isPreview } from '../lib/url';
const tel = isPreview || filled(site.phone);
import { h } from '../lib/txt';
import LeadForm from './LeadForm.astro';
interface Props { id?: string; title?: string; text?: string }
const { id = 'prenota-2', title = 'Veniamo a misurare il tuo bagno, gratis', text = 'Lasciaci il CAP e un numero di telefono. Un nostro tecnico ti chiama per fissare il sopralluogo quando ti fa comodo.' } = Astro.props;
---
<section class="section">
  <div class="wrap">
    <div class="cta-band">
      <div>
        <h2>{title}</h2>
        <p>{text}</p>
        {tel && <div class="contacts">
          <a class="btn btn--light" href={`tel:${site.phoneHref}`}>Chiama il <span set:html={h(site.phone)} /></a>
          <a class="btn btn--wa" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>
        </div>}
      </div>
      <LeadForm id={id} title="Prenota il sopralluogo gratuito" />
    </div>
  </div>
</section>
