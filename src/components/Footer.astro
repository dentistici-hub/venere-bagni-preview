---
import { site, nav, zones, filled } from '../data/site';
import { u } from '../lib/url';
import { h, orLive } from '../lib/txt';
import Logo from './Logo.astro';
import { isPreview } from '../lib/url';
// minimal: ads landing footer (company data, phone, hours, legal links only; no navigation)
interface Props { minimal?: boolean }
const { minimal = false } = Astro.props;
---
<footer class="ftr">
  <div class="wrap">
    {minimal ? (
      <>
      <p set:html={h(orLive(`${site.brand} · ${site.legalName} · P.IVA ${site.vat} · REA ${site.rea} · ${site.street}`, `${site.brand} · ${site.legalName}`))} />
      {isPreview || filled(site.phone) ? <p>Telefono <a href={`tel:${site.phoneHref}`} set:html={h(site.phone)} /> · <span set:html={h(`Orari ${site.hours}`)} /></p> : <p>Email <a href={`mailto:${site.email}`}>{site.email}</a></p>}
      </>
    ) : (
    <div class="ftr__grid">
      <div>
        <Logo variant="plain" />
        <p>Trasformazione vasca in doccia, vasca con sportello e bagno sicuro a Torino e in tutto il Piemonte.</p>
        <p set:html={h(orLive(`${site.legalName} · ${site.street}, ${site.postalCode} ${site.locality} · P.IVA ${site.vat} · REA ${site.rea}`, `${site.legalName} · ${site.locality}`))} />
      </div>
      <div>
        <h3>Servizi</h3>
        <ul>{nav.map((l) => <li><a href={u(l.href)}>{l.label}</a></li>)}</ul>
      </div>
      <div>
        <h3>Zone servite</h3>
        <ul>
          {zones.map((z) => <li><a href={u(`/zone/${z.slug}/`)}>Vasca in doccia {z.at}</a></li>)}
        </ul>
      </div>
      <div>
        <h3>Azienda e contatti</h3>
        <ul>
          <li><a href={u('/chi-siamo/')}>Chi siamo</a></li>
          <li><a href={u('/guide/')}>Guide</a></li>
          {(isPreview || filled(site.phone)) && <li>Telefono <a href={`tel:${site.phoneHref}`} set:html={h(site.phone)} /></li>}
          {(isPreview || filled(site.whatsappLabel)) && <li>WhatsApp <a href={`https://wa.me/${site.whatsapp}`} set:html={h(site.whatsappLabel)} /></li>}
          <li>Email <a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></li>
          {(isPreview || filled(site.hours)) && <li set:html={h(`Orari ${site.hours}`)} />}
          <li><a href={u('/contatti/')}>Pagina contatti</a></li>
        </ul>
      </div>
    </div>
    )}
    <div class="ftr__legal">
      <span>© {new Date().getFullYear()} {site.brand} · <a href={u('/privacy/')}>Privacy</a> · <a href={u('/cookie/')}>Cookie</a> · <button type="button" data-consent-open>Gestisci cookie</button></span>
      <span>In collaborazione con <a href="https://www.profilomarketing.it/" rel="noopener">Profilo Marketing</a></span>
    </div>
  </div>
</footer>
